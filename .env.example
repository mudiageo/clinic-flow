# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
# GitHub OAuth
# https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# AI Voice Intake (Gemini)
GEMINI_API_KEY=""

# SMS Reminders (Termii Sandbox)
TERMII_API_KEY=""
TERMII_SENDER_ID=""

# Firebase Web Configuration & Hybrid AI (#BuildHybridAI 2026)
PUBLIC_FIREBASE_API_KEY=""
PUBLIC_FIREBASE_AUTH_DOMAIN=""
PUBLIC_FIREBASE_PROJECT_ID=""
PUBLIC_FIREBASE_STORAGE_BUCKET=""
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
PUBLIC_FIREBASE_APP_ID=""
PUBLIC_FIREBASE_MEASUREMENT_ID=""

# Firebase App Check (Debug Token for local dev & demo)
PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=""
PUBLIC_FIREBASE_APPCHECK_RECAPTCHA_KEY=""

# Firebase Remote Config Fallback Overrides
PUBLIC_FIREBASE_AI_FALLBACK_MODEL="gemini-2.5-flash"
